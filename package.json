{
  "name": "controle-de-horas",
  "version": "1.0.0",
  "description": "Aplicativo de Controle de Horas conectado a Planilha Excel",
  "main": "main.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "package": "pkg .",
    "start-desktop": "electron .",
    "package-desktop": "electron-packager . controle-de-horas --platform=win32 --arch=x64 --icon=public/icon.ico --overwrite --out=dist --ignore=\"^/dist($|/)\" --ignore=\"^/scratch($|/)\" --ignore=\"^/backups($|/)\" --ignore=\"^/\\.git($|/)\" --ignore=\"^/\\.gemini($|/)\"",
    "build-installer": "electron-builder --win --x64"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "localtunnel": "^2.0.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-packager": "^17.1.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.andreturco.controlehoras",
    "productName": "Controle de Horas Premium",
    "compression": "store",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Controle de Horas Premium"
    },
    "files": [
      "**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/electron-packager/**/*",
      "!node_modules/app-builder-bin/**/*",
      "!node_modules/typescript/**/*",
      "!dist/**/*",
      "!dist-installer/**/*",
      "!backups/**/*",
      "!scratch/**/*",
      "!.git/**/*",
      "!.gemini/**/*",
      "!Controle_de_Horas_Trabalho-1.xlsx",
      "!config_registro.json",
      "!senha_acesso.txt",
      "!tunnel_url.json",
      "!url_acesso.txt"
    ]
  }
}

